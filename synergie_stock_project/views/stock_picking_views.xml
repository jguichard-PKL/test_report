<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire transfert : champ Projet (saisi sur le bon de réception).
         Placé après "Document d'origine" (origin), zone d'en-tête présente
         sur tous les types de transferts.
    -->
    <record id="view_picking_form_project" model="ir.ui.view">
        <field name="name">stock.picking.form.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>

</odoo>
