<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire transfert : champ Projet (saisi sur le bon de réception).
         Placé après "Document d'origine" (origin), zone d'en-tête présente
         sur tous les types de transferts.
         [À vérifier v19] id de vue : stock.view_picking_form ; ancre 'origin'. -->
    <record id="view_picking_form_project" model="ir.ui.view">
        <field name="name">stock.picking.form.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>

    <!-- Recherche transfert : filtre + regroupement par projet.
         [À vérifier v19] id de vue : stock.view_picking_internal_search -->
    <record id="view_picking_internal_search_project" model="ir.ui.view">
        <field name="name">stock.picking.search.project</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="project_id"/>
                <separator/>
                <filter name="group_project" string="Projet"
                        context="{'group_by': 'project_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
