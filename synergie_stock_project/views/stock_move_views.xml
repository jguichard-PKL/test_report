<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire mouvement de stock : champ Projet (éditable).
         Le projet est auto-calculé (compute) mais reste modifiable.
         [À vérifier v19] id de vue : stock.view_move_form -->
    <record id="view_move_form_project" model="ir.ui.view">
        <field name="name">stock.move.form.project</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>

</odoo>
