<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_planning_generate_wizard_form" model="ir.ui.view">
        <field name="name">project.planning.generate.wizard.form</field>
        <field name="model">project.planning.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer la planification prévisionnelle">
                <field name="project_id" invisible="1"/>
                <group>
                    <field name="anchor_date"/>
                    <field name="input_qty"/>
                </group>
                <group string="Étapes actives du flow">
                    <group>
                        <field name="has_bumping"/>
                        <field name="wafer_test_temp_count"/>
                        <field name="has_retention_bake"/>
                    </group>
                    <group>
                        <field name="final_test_temp_count"/>
                    </group>
                </group>
                <group string="Rendements attendus (%) — 100 = pas de perte">
                    <field name="yield_wafer_test"/>
                    <field name="yield_assembly"/>
                    <field name="yield_final_test"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_planning_generate_wizard" model="ir.actions.act_window">
        <field name="name">Générer la planification prévisionnelle</field>
        <field name="res_model">project.planning.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
