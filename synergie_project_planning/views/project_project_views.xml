<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton d'accès au wizard (§4.2 de la spec), sur l'en-tête du
         formulaire projet. type="action" + référence directe à l'action du
         wizard : Odoo passe alors automatiquement active_id/active_model
         dans le contexte de l'action, exploité par le default de
         project_id sur le wizard — pas besoin de méthode Python dédiée sur
         project.project.
         [À vérifier v19] id de vue : project.edit_project. -->
    <record id="edit_project_planning_button" model="ir.ui.view">
        <field name="name">project.project.form.planning.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="%(synergie_project_planning.action_project_planning_generate_wizard)d"
                        type="action"
                        string="Générer la planification prévisionnelle"
                        class="btn-secondary"
                        invisible="is_template"/>
            </header>
        </field>
    </record>

</odoo>
