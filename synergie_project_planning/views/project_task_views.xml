<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Nouvelle page sur le formulaire tâche : champs de suivi de la
         maquette. Insérée en fin de notebook (position "inside" sur
         <notebook>, pas ancrée à une page cœur précise) pour rester robuste
         si l'ordre/le nom des pages cœur change.

         Ne référence JAMAIS planned_date_begin / planned_date_end : ces
         champs natifs (Gantt Enterprise) ne sont pas garantis présents sur
         toute instance (état incohérent constaté en test réel, cf. README
         §0) — les référencer ici casserait l'INSTALLATION du module si
         absents. Quand ils sont disponibles, la vue Enterprise les affiche
         déjà ; rien à ajouter côté ce module.

         depend_on_ids n'est pas repris ici : déjà éditable nativement via
         la page cœur "Blocked By" (project.view_task_form2), visible dès
         que allow_task_dependencies est actif sur le projet (posé par le
         wizard). Idem pour les jalons (page cœur dédiée, actifs dès que
         allow_milestones est posé par le wizard).

         [À vérifier v19] id de vue : project.view_task_form2. -->
    <record id="view_task_form2_planning" model="ir.ui.view">
        <field name="name">project.task.form.planning</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="planning_prototype" string="Planification prévisionnelle">
                    <group>
                        <group string="Suivi réel">
                            <field name="x_actual_end_date"/>
                            <field name="x_deviation_days"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_generated_by_wizard" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
